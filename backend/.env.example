# Application
APP_NAME="AI Learning Companion"
APP_ENV=local
DEBUG=true
API_PREFIX=/api/v1
SECRET_KEY=change-me-generate-a-long-random-value
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (Neon PostgreSQL connection string)
DATABASE_URL=

# Groq
GROQ_API_KEY=

# Google AI (Gemini embeddings)
GOOGLE_API_KEY=

# Knowledge / RAG (all prototype defaults are safe to keep)
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001
GOOGLE_EMBEDDING_DIMENSIONS=768
EMBEDDING_DIMENSIONS=768
GROQ_MODEL_CONCEPTS=openai/gpt-oss-20b
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=3
RAG_TOP_K=8
RAG_SIMILARITY_THRESHOLD=0.3
RAG_MAX_CONTEXT_CHUNKS=8
RAG_MAX_CONTEXT_CHARS=12000
CONCEPT_MAX_INPUT_CHARS=12000
CONCEPT_MAX_PER_RUN=20
# TEST_FAKE_AI=true  # test/E2E only: deterministic fake AI. NEVER in production.

# Redis / Upstash
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
# Optional overrides if not using Upstash URL directly as broker:
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# Storage: local filesystem for dev/test, Neon Object Storage (S3-compatible) for production
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
# Production object storage (all required when STORAGE_BACKEND=neon; endpoint + region from Neon console)
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_BUCKET_NAME=

# Materials: upload + async PDF processing (all prototype defaults are safe to keep)
MAX_UPLOAD_BYTES=26214400
PROCESSING_MAX_PAGES=500
PROCESSING_MAX_CHARS=2000000
PROCESSING_CHUNK_SIZE=1000
PROCESSING_CHUNK_OVERLAP=150
PROCESSING_MIN_CHUNK_CHARS=100
OCR_MIN_CHARS_PER_PAGE=50
OCR_ENABLED=true
PROCESSING_STALE_CLAIM_MINUTES=30
# Embedded PDF image extraction (all prototype defaults are safe to keep)
PDF_IMAGE_EXTRACTION_ENABLED=true
PDF_MIN_IMAGE_WIDTH=100
PDF_MIN_IMAGE_HEIGHT=100
PDF_MIN_IMAGE_BYTES=2048
PDF_MAX_IMAGES_PER_PAGE=10
PDF_MAX_IMAGES_PER_DOCUMENT=50
# Local/dev broker stand-in (filesystem). Production sets CELERY_BROKER_URL to
# Upstash Redis instead; CELERY_FILESYSTEM_ROOT is ignored there.
# CELERY_FILESYSTEM_ROOT=/tmp/alc-celery-fs

# Authentication
JWT_SECRET_KEY=change-me-generate-a-long-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Minimal RBAC bootstrap: listed emails are promoted to admin on register/login
ADMIN_EMAILS=
# Login brute-force throttle (failed attempts per email per window -> 429)
LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW_SECONDS=300
# API docs are served in dev, hidden in production unless explicitly enabled
ENABLE_API_DOCS=false
# SQLAlchemy pool (modest dev defaults; raise for production)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
# Groq client timeout (seconds): no model call waits forever
GROQ_TIMEOUT_SECONDS=60
